# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test and coverage
coverage/
.nyc_output/

# Environment and secrets
.env
.env.*
!.env.example

# Tooling caches
.turbo/
.cache/
