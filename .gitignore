# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Test and coverage
coverage/
.nyc_output/

# Environment and secrets
.env
.env.*
!.env.example

# Tooling caches
.turbo/
.cache/
.eslintcache

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local artefacts
*.log
tmp/
examples/**/*.target.json

# What the stack writes when it runs. The link table itself is tracked, because it is the
# worked example; what the console authors and what it publishes are local state.
infra/workspace/*
!infra/workspace/.gitkeep
infra/bundles/*
!infra/bundles/.gitkeep

# The console's lock files, written while it runs and removed when it stops properly.
# One sits inside the workspace and one beside the link table, so both spellings.
.console-lock
*.console-lock

# Written by a run of the compiler's command line from the repository root, the way the
# stack job does before it publishes a bundle into the containers.
front.target.json

# Written by the CI test step so a failed run can be read without log access.
test-output.txt

# Assembled by the pages workflow, not checked in.
site/measure/runtime/
site/measure/front.target.json
site/artwork.png
