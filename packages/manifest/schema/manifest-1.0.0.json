{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taggant.dev/schema/manifest-1.0.0.json",
  "title": "Taggant experience manifest",
  "description": "Describes one published experience: the physical thing it belongs to, the targets that recognise it, and the content anchored to each target.",
  "type": "object",
  "required": ["schemaVersion", "id", "targets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "title": { "type": "string", "maxLength": 200 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["product", "print", "artwork", "other"] },
        "reference": { "type": "string", "maxLength": 200 }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "fallback": {
      "description": "Where a scan goes when the experience cannot be shown. A viewer navigates to it, so the scheme is held to http and https: a manifest is authored data and must not be able to carry script into a browser.",
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2000
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": ["id", "source", "physicalWidthMm", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "source": { "type": "string", "maxLength": 300 },
        "physicalWidthMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 5000 },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/content" } }
      }
    },
    "content": {
      "type": "object",
      "required": ["type", "src"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["image", "video", "model", "audio"] },
        "src": {
          "description": "Path to the asset, relative to the manifest. Relative by design: a published experience is a self contained bundle, so an absolute URL would make it depend on a host that can go away. Parent directory steps are refused because the path is resolved against a bundle directory.",
          "type": "string",
          "maxLength": 300,
          "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*:)[A-Za-z0-9._~/-]+$"
        },
        "placement": { "$ref": "#/$defs/placement", "default": {} },
        "autoplay": { "type": "boolean", "default": true },
        "loop": { "type": "boolean", "default": true },
        "muted": {
          "type": "boolean",
          "default": true,
          "description": "Muted by default because no browser will autoplay a video with sound. Set autoplay to false to let a viewer start it with sound themselves."
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 20, "default": 1 },
        "offsetX": { "type": "number", "minimum": -10, "maximum": 10, "default": 0 },
        "offsetY": { "type": "number", "minimum": -10, "maximum": 10, "default": 0 },
        "rotationDeg": { "type": "number", "minimum": -360, "maximum": 360, "default": 0 }
      }
    }
  }
}
