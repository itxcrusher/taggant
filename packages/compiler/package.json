{
  "name": "@taggant/compiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "taggant-compile": "./dist/cli.js" },
